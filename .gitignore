# --- 秘匿情報: 絶対にコミットしない ---
.env
.env.*
!.env.example
.secrets/
*.pem
*.key

# --- 生成データ ---
# 先頭の / でリポジトリ直下だけを対象にする。付けないと src/wbjp/data/
# （足データの取得と保存を担うソース）まで巻き込んで無視してしまう。
/data/
# サーバー固有の状態（発注台帳・ログ・バックアップ）。data/ と違い
# ホスト間でコピーしてはいけないもの
/state/
*.db
*.db-journal
*.sqlite3
*.parquet
logs/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- OS/エディタ ---
.DS_Store
.idea/
.vscode/
.claude/

# Webull SDK が勝手に作るログ（マスクを通らないため必ず除外）
webull_*_sdk.log
