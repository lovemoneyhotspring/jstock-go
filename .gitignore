# --- 秘匿情報: 絶対にコミットしない ---
.env
.env.*
!.env.example
.secrets/
*.pem
*.key

# --- 生成データ ---
# 先頭の / でリポジトリ直下だけを対象にする。付けないと pkg/wbcore/data/
# （足データの取得と保存を担うソース）まで巻き込んで無視してしまう。
/data/
# サーバー固有の状態（発注台帳・ログ・バックアップ）。data/ と違い
# ホスト間でコピーしてはいけないもの
/state/
# 試験が控えの置き場を差し替え忘れると、パッケージの下に state/ を作ってしまう
state/notify/
*.db
*.db-journal
*.sqlite3
*.parquet
logs/

# --- Go ---
# deploy/build.sh が作る実行ファイル。中身はホストの CPU / OS 依存なので配らない
/bin/
# `go build ./cmd/wbjp` は -o を付けないとカレントに実行ファイルを落とす
/wbjp
/accum
/daytrade
/jquants
/discord-post

# --- OS/エディタ ---
.DS_Store
.idea/
.vscode/
# Claude Code のローカル状態は無視するが、サブエージェントの定義は
# 運用設定（deploy/crontab.txt と同格）なので追跡する
.claude/*
!.claude/agents/
