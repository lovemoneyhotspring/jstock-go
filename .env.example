# wbjp の環境設定。このファイルを .env にコピーして使う（.env は gitignore 済み）。
#
# 秘密を .env に書くなら **必ず chmod 600 する**:
#   cp .env.example .env && chmod 600 .env
#
# APIキーの置き場所は3つ。上から順に読まれ、最初に見つかったものが使われる:
#   1. 環境変数        … systemd の EnvironmentFile= / CI（サーバー運用の推奨）
#   2. この .env       … キーチェーンの無いホスト向け
#   3. OS キーチェーン … ローカル開発の推奨: uv run wbjp credentials set --env uat
#
# どこから読まれているかは `uv run wbjp credentials check --env prod` で確認できる。

# 接続先の環境。uat = テスト（実弾なし） / prod = 本番
WBJP_ENV=uat

# ログ
WBJP_LOG_LEVEL=INFO
WBJP_LOG_JSON=false

# 保存先
WBJP_DATA_DIR=data
WBJP_CONFIG_DIR=config
# ログの置き場。ファイルに残すログはここ 1 箇所だけ（既定は WBJP_DATA_DIR/logs）。
# 本番では絶対パスにする（cron はカレントディレクトリが違う）。
# WBJP_LOG_DIR=/var/lib/wbjp/logs

# --- APIキー ---
# ローカル開発ではキーチェーンを使うこと。ヘッドレスな Linux サーバーなど
# キーチェーンが使えない環境でのみ、以下のコメントを外して設定する。
# WBJP_UAT_APP_KEY=
# WBJP_UAT_APP_SECRET=
# WBJP_UAT_ACCOUNT_ID=
# WBJP_PROD_APP_KEY=
# WBJP_PROD_APP_SECRET=
# WBJP_PROD_ACCOUNT_ID=
#
# APIキーの発行日。45日で失効するため、残り日数の警告に使う。
# WBJP_PROD_KEY_CREATED_ON=2026-08-25

# J-Quants API（日本株の足データ）。ダッシュボードで発行した API キー（期限なし）。
# 環境（uat / prod）で分けない。当日の判断に使うなら Light 以上のプランが要る
# （Free は直近 12 週が取れない）。
# WBJP_JQUANTS_API_KEY=

# 画面とログに出す時刻の時間帯。保存と演算は常に UTC。既定は UTC
# WBJP_TIMEZONE=Asia/Tokyo
