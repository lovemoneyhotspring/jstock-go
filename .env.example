# wbjp の環境設定。**秘密はここに書かない。**
# このファイルを .env にコピーして使う（.env は gitignore 済み）。
#
# APIキーは OS のキーチェーンに保存する:
#   uv run wbjp credentials set --env uat

# 接続先の環境。uat = テスト（実弾なし） / prod = 本番
WBJP_ENV=uat

# ログ
WBJP_LOG_LEVEL=INFO
WBJP_LOG_JSON=false

# 保存先
WBJP_DATA_DIR=data
WBJP_CONFIG_DIR=config

# --- 以下はサーバー運用や CI で、キーチェーンが使えない場合のみ ---
# ローカル開発ではキーチェーンを使うこと。
# WBJP_UAT_APP_KEY=
# WBJP_UAT_APP_SECRET=
# WBJP_UAT_ACCOUNT_ID=
# WBJP_PROD_APP_KEY=
# WBJP_PROD_APP_SECRET=
# WBJP_PROD_ACCOUNT_ID=
#
# APIキーの発行日。45日で失効するため、残り日数の警告に使う。
# WBJP_PROD_KEY_CREATED_ON=2026-08-25
