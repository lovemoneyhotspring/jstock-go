# wbjp の環境設定。このファイルを .env にコピーして使う（.env は gitignore 済み）。
#
# 秘密を .env に書くなら **必ず chmod 600 する**:
#   cp .env.example .env && chmod 600 .env
#
# 認証情報の置き場所は3つ。上から順に読まれ、最初に見つかったものが使われる:
#   1. 環境変数        … systemd の EnvironmentFile= / CI（サーバー運用の推奨）
#   2. この .env       … キーチェーンの無いホスト向け
#   3. OS キーチェーン … サービス名 tachibana/<env>、項目 auth_id / private_key_file / order_password
#
# どこから読まれているかは `uv run wbjp credentials check --env prod` で確認できる。

# 接続先の環境。uat = テスト（実弾なし） / prod = 本番
WBJP_ENV=uat

# ログ
WBJP_LOG_LEVEL=INFO
WBJP_LOG_JSON=false

# 保存先。data はキャッシュ・アーカイブ（ホスト間でコピーしてよい）、
# state はサーバー固有の状態＝発注台帳・ログ・バックアップ（上書き厳禁）。
WBJP_DATA_DIR=data
WBJP_STATE_DIR=state
WBJP_CONFIG_DIR=config
# ログの置き場。ファイルに残すログはここ 1 箇所だけ（既定は WBJP_STATE_DIR/logs）。
# 本番では絶対パスにする（cron はカレントディレクトリが違う）。
# WBJP_LOG_DIR=/var/lib/wbjp/state/logs

# --- 立花証券 e支店 API（発注・時価）---
# 取得手順は docs/DEPLOY.md「立花証券 e支店」。本番（prod）とデモ（uat）で認証ID・鍵は別管理。
#   AUTH_ID          … e支店 Web の「ｅ支店・ＡＰＩ利用設定」で自動生成される認証ID
#   PRIVATE_KEY_FILE … 同画面で登録した公開鍵と対の秘密鍵（PEM）のパス。chmod 600
#   ORDER_PASSWORD   … 第二暗証番号（注文・取消に毎回必要）
# TACHIBANA_UAT_AUTH_ID=
# TACHIBANA_UAT_PRIVATE_KEY_FILE=/path/to/tachibana-uat.pem
# TACHIBANA_UAT_ORDER_PASSWORD=
# TACHIBANA_PROD_AUTH_ID=
# TACHIBANA_PROD_PRIVATE_KEY_FILE=/path/to/tachibana-prod.pem
# TACHIBANA_PROD_ORDER_PASSWORD=

# J-Quants API（日本株の足データ）。ダッシュボードで発行した API キー（期限なし）。
# 環境（uat / prod）で分けない。当日の判断に使うなら Light 以上のプランが要る
# （Free は直近 12 週が取れない）。
# WBJP_JQUANTS_API_KEY=

# Discord への通知（Bot の REST API で送る。Incoming Webhook は使わない）。
# 未設定ならログに残るだけ。1 通知 1 スレッドで、送るたびに新しいスレッドを作る。
#
# 用意するもの:
#   1. Discord Developer Portal で Bot を作り、トークンをコピー
#   2. サーバーに「チャンネルを見る」「メッセージを送信」「公開スレッドの作成」
#      「スレッドでメッセージを送信」の権限で招待
#   3. 送りたいチャンネルを右クリック →「チャンネル ID をコピー」（開発者モードが要る）
#
#   WBJP_ALERT_CHANNEL_ID  … cron の中で起きた異常（動作に問題があったとき）の報告先
#   WBJP_REPORT_CHANNEL_ID … 21:00 の日次レポート（deploy/daily-report.sh）の送り先。
#                            無ければ WBJP_ALERT_CHANNEL_ID に流す
#   WBJP_MENTION_USER_ID   … 投稿のたびに呼びかける相手のユーザー ID（カンマ区切りで複数可）。
#                            "@名前" では通知が飛ばないので ID で書く。Discord の設定で
#                            開発者モードを有効にし、相手を右クリック →「ユーザー ID をコピー」
# 通常のテキストチャンネルでもフォーラムチャンネルでもよい。
# 送ったものは state/notify/<日付>.jsonl に 30 日ぶん控えが残る（送れなかったものも）
# WBJP_DISCORD_BOT_TOKEN=
# WBJP_ALERT_CHANNEL_ID=
# WBJP_REPORT_CHANNEL_ID=
# WBJP_MENTION_USER_ID=

# 画面とログに出す時刻の時間帯。保存と演算は常に UTC。既定は UTC
# WBJP_TIMEZONE=Asia/Tokyo
