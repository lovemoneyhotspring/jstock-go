[Unit]
Description=jstock-go: cron の close が走っていなければ代わりに手仕舞う（安全網）
# cron とは別系統。マシンが生きていれば、cron・crontab が壊れていても引けの手仕舞いに間に合う

[Service]
Type=oneshot
WorkingDirectory=@HOME_DIR@
Environment=WBJP_HOME=@HOME_DIR@
Environment=WBJP_ENV=prod
Environment=PATH=@PATH@
ExecStart=@HOME_DIR@/deploy/close-net.sh
# with-lock.sh の打ち切り（170 秒）より少し長く
TimeoutStartSec=240
# 終わり方を state/ping/CLOSENET に残し（Mackerel の alive.closenet）、時間切れ・シグナルで止められたときは
# Discord に知らせる（deploy/unit-done.sh。jstock-guard.service と同じ形）
ExecStopPost=@HOME_DIR@/deploy/unit-done.sh CLOSENET "デイトレ: 引けの安全網" "手仕舞えていない建玉が残っていないか口座を確かめてください（保険の引け注文があれば引けで手仕舞われます）。"
TimeoutStopSec=150
